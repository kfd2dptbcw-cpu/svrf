# ─────────────────────────────────────────────────────────────────────────────
# UK Surf Forecast — environment variables
# Copy to .env.local for development. Every variable is optional unless noted.
# ─────────────────────────────────────────────────────────────────────────────

# Public URL of the site (used for canonical URLs, sitemap, Open Graph, embeds).
# Required in production.
NEXT_PUBLIC_SITE_URL=https://surf.example.com
NEXT_PUBLIC_SITE_NAME="SVRF Surf Forecast"

# Serve the app under a sub-path of your existing site, e.g. /surf-forecast
# (leave empty to serve from the domain root).
NEXT_BASE_PATH=

# ── Scheduled refresh ───────────────────────────────────────────────────────
# Forecasts are refreshed ONLY by `npm run refresh` (run by the GitHub Actions workflow
# .github/workflows/scheduled-refresh.yml). The site never calls the data providers itself.
# A refresh refuses to start within 3 hours of the previous attempt (`--force` overrides).
# Secret for the read-only /api/cron/refresh status endpoint (also regenerates pages).
# Required in production (the endpoint refuses to run without it).
CRON_SECRET=change-me-to-a-long-random-string
# UTC hours at which a new forecast becomes due (comma separated).
REFRESH_HOURS_UTC=6,18
# Log a loud warning when refreshes spent more than this many API accesses in 24 hours.
XWEATHER_DAILY_WARN=300

# ── Data providers ──────────────────────────────────────────────────────────
# Primary forecast source:
#   xweather   Vaisala Xweather — free developer tier of 15,000 accesses/month, then paid.
#              Cost per refresh is NOT yet confirmed: at least 2 accesses per spot (≈4,200/month for
#              34 spots × 2 refreshes/day × 31 days) if requests bill flat, but Xweather may bill a
#              multi-day request per day or per period covered. Run `npm run provider:check` with real
#              keys: it reads the actual X-Cost-Tokens charge and recommends the settings below.
#   open-meteo Free for NON-COMMERCIAL use only; commercial use needs an Open-Meteo plan or self-hosting.
#   sample     Synthetic data for offline development — never in production.
# Defaults to xweather when XWEATHER_CLIENT_ID is set, otherwise open-meteo.
FORECAST_DATA_SOURCE=xweather
# Optional backup for spots/requests the primary can't serve: xweather | open-meteo | none.
# Only use open-meteo here if your use is non-commercial or you have an Open-Meteo plan/self-hosted instance.
FALLBACK_DATA_SOURCE=none
FORECAST_DAYS=7

# Vaisala Xweather credentials (https://signup.xweather.com/ → Apps → register your domain).
XWEATHER_CLIENT_ID=
XWEATHER_CLIENT_SECRET=
# XWEATHER_API_URL=https://data.api.xweather.com
# 1 = hourly, 3 = 3-hourly (resampled to hourly; fewer billed periods if Xweather bills per period).
XWEATHER_INTERVAL_HOURS=1
# Monthly access budget provider:check plans against (keep below the free 15,000).
XWEATHER_MONTHLY_BUDGET=12000
# Hard cap: skip Xweather refreshes and serve cached forecasts below this many accesses left this
# billing period; log a warning below the second value.
XWEATHER_MIN_REMAINING=1000
XWEATHER_WARN_REMAINING=3000

# ── Open-Meteo (only when used as primary or fallback) ──────────────────────
# Marine models tried in order for spots the previous model can't cover.
OPEN_METEO_MARINE_MODELS=best_match,ncep_gfswave025
# Override endpoints (e.g. a self-hosted Open-Meteo instance or the commercial API).
# OPEN_METEO_MARINE_URL=https://marine-api.open-meteo.com/v1/marine
# OPEN_METEO_WEATHER_URL=https://api.open-meteo.com/v1/forecast
# Only for Open-Meteo's commercial plans — the free API needs no key.
# OPEN_METEO_API_KEY=

# modelled (tide levels from the marine provider) | admiralty (official UKHO predictions
# for spots with a tideStationId; others fall back to modelled tides)
TIDE_PROVIDER=modelled
# Free "Discovery" key from https://admiraltyapi.portal.azure-api.net/
# ADMIRALTY_API_KEY=

HTTP_TIMEOUT_MS=15000
HTTP_RETRIES=2

# ── Cache ───────────────────────────────────────────────────────────────────
# file (default) | memory | upstash (auto-selected when the Upstash variables are set)
CACHE_DRIVER=file
# Directory for the file cache (defaults to .forecast-cache, or /tmp/forecast-cache on Vercel).
# CACHE_DIR=/var/cache/surf-forecast
# Recommended on serverless hosts so all instances share one cache:
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=

# ── Embedding ───────────────────────────────────────────────────────────────
# Space-separated origins allowed to iframe the /embed widgets (CSP frame-ancestors).
EMBED_ALLOWED_ORIGINS=*
# Origins allowed to iframe the full site (default: same origin only).
# FRAME_ANCESTORS='self' https://www.example.com

# ── Map ─────────────────────────────────────────────────────────────────────
# Tile server and attribution (defaults to OpenStreetMap; respect its usage policy
# or use a provider such as MapTiler/Stadia/Carto for high traffic).
# NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors

# Set to "standalone" for Docker / self-hosted builds.
# NEXT_OUTPUT=standalone
