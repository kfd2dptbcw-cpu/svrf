# ─────────────────────────────────────────────────────────────────────────────
# UK Surf Forecast — environment variables
# Copy to .env.local for development. Every variable is optional unless noted.
# ─────────────────────────────────────────────────────────────────────────────

# Public URL of the site (used for canonical URLs, sitemap, Open Graph, embeds).
# Required in production.
NEXT_PUBLIC_SITE_URL=https://surf.example.com
NEXT_PUBLIC_SITE_NAME="UK Surf Forecast"

# Serve the app under a sub-path of your existing site, e.g. /surf-forecast
# (leave empty to serve from the domain root).
NEXT_BASE_PATH=

# ── Scheduled refresh ───────────────────────────────────────────────────────
# Secret for /api/cron/refresh. Vercel Cron sends "Authorization: Bearer $CRON_SECRET".
# Required in production (the endpoint refuses to run without it).
CRON_SECRET=change-me-to-a-long-random-string
# UTC hours at which a new forecast becomes due (comma separated).
REFRESH_HOURS_UTC=6,18
# Minimum seconds between failed refresh attempts (protects upstream APIs).
REFRESH_FAILURE_BACKOFF_SECONDS=900

# ── Data providers ──────────────────────────────────────────────────────────
# open-meteo (default, live data) | sample (synthetic data for offline development — never in production)
FORECAST_DATA_SOURCE=open-meteo
FORECAST_DAYS=7
# Marine models tried in order for spots the previous model can't cover.
OPEN_METEO_MARINE_MODELS=best_match,ncep_gfswave025
# Override endpoints (e.g. a self-hosted Open-Meteo instance or the commercial API).
# OPEN_METEO_MARINE_URL=https://marine-api.open-meteo.com/v1/marine
# OPEN_METEO_WEATHER_URL=https://api.open-meteo.com/v1/forecast
# Only for Open-Meteo's commercial plans — the free API needs no key.
# OPEN_METEO_API_KEY=

# open-meteo (modelled tide from the marine model) | admiralty (official UKHO predictions
# for spots with a tideStationId; others fall back to modelled tides)
TIDE_PROVIDER=open-meteo
# Free "Discovery" key from https://admiraltyapi.portal.azure-api.net/
# ADMIRALTY_API_KEY=

HTTP_TIMEOUT_MS=15000
HTTP_RETRIES=2

# ── Cache ───────────────────────────────────────────────────────────────────
# file (default) | memory | upstash (auto-selected when the Upstash variables are set)
CACHE_DRIVER=file
# Directory for the file cache (defaults to .forecast-cache, or /tmp/forecast-cache on Vercel).
# CACHE_DIR=/var/cache/surf-forecast
# Recommended on serverless hosts so all instances share one cache:
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=

# ── Embedding ───────────────────────────────────────────────────────────────
# Space-separated origins allowed to iframe the /embed widgets (CSP frame-ancestors).
EMBED_ALLOWED_ORIGINS=*
# Origins allowed to iframe the full site (default: same origin only).
# FRAME_ANCESTORS='self' https://www.example.com

# ── Map ─────────────────────────────────────────────────────────────────────
# Tile server and attribution (defaults to OpenStreetMap; respect its usage policy
# or use a provider such as MapTiler/Stadia/Carto for high traffic).
# NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors

# Set to "standalone" for Docker / self-hosted builds.
# NEXT_OUTPUT=standalone
